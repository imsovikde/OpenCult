# OpenCult local environment template (copy to .env.local, never commit real keys)
OPENCULT_SUPABASE_URL=https://your-project-ref.supabase.co
OPENCULT_SUPABASE_ANON_KEY=your-public-anon-key
# Optional public Cloudflare Turnstile site key (safe for Android BuildConfig; leave blank to skip widget)
OPENCULT_TURNSTILE_SITE_KEY=
#
# Server-side Supabase CLI secrets (configure via `supabase secrets set`; NEVER place in .env.local for APK builds):
#   SUPABASE_TURNSTILE_SECRET=<cloudflare-turnstile-secret-key>
#   BEFORE_USER_CREATED_HOOK_SECRET=<v1,whsec_...>
